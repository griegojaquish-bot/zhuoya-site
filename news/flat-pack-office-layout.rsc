1:["$","main",null,{"className":"article","children":[["$","header",null,{"className":"detailTop","children":[["$","a",null,{"className":"brand","href":"/","children":[["$","b",null,{"children":"ZY"}],["$","span",null,{"children":["卓雅集成房屋",["$","small",null,{"children":"ZHUOYA MODULAR HOUSING"}]]}]]}],["$","div",null,{"children":[["$","a",null,{"href":"/news","children":"返回资讯"}],["$","a",null,{"className":"detailCta","href":"/#contact","children":"项目咨询 →"}]]}]]}],["$","section",null,{"className":"articleHero","children":[["$","small",null,{"children":["产品应用","　·　","2026 / 07 / 14"]}],["$","h1",null,{"children":"打包箱如何组合成高效办公空间？"}],["$","p",null,{"children":"打包箱的价值不只是一间独立房间，更在于它可以像积木一样被组织成适合项目团队的办公空间。"}]]}],["$","div",null,{"className":"articleBody","children":[["$","aside",null,{"children":[["$","span",null,{"children":"目录"}],[["$","a","从人员和动线开始",{"href":"#section-1","children":["0",1,"　","从人员和动线开始"]}],["$","a","用组合解决空间尺度",{"href":"#section-2","children":["0",2,"　","用组合解决空间尺度"]}],["$","a","让配置跟上使用需求",{"href":"#section-3","children":["0",3,"　","让配置跟上使用需求"]}]]]}],["$","article",null,{"children":[[["$","section","从人员和动线开始",{"id":"section-1","children":[["$","h2",null,{"children":"从人员和动线开始"}],[["$","p","项目负责人、工程管理、资料、会议接待等人员的工作方式不同，应在平面规划中形成安静办公区、公共协作区和对外接待区。",{"children":"项目负责人、工程管理、资料、会议接待等人员的工作方式不同，应在平面规划中形成安静办公区、公共协作区和对外接待区。"}],["$","p","入口、走廊和楼梯的位置也会影响日常效率，应尽量减少交叉流线。",{"children":"入口、走廊和楼梯的位置也会影响日常效率，应尽量减少交叉流线。"}]]]}],["$","section","用组合解决空间尺度",{"id":"section-2","children":[["$","h2",null,{"children":"用组合解决空间尺度"}],[["$","p","两个或多个模块并联，可形成会议室、开放办公区和接待空间；双层组合可在有限场地中增加使用面积；连廊、雨棚可提升雨天通行体验。",{"children":"两个或多个模块并联，可形成会议室、开放办公区和接待空间；双层组合可在有限场地中增加使用面积；连廊、雨棚可提升雨天通行体验。"}],["$","p","模块化的优势在于可以在项目推进中逐步扩展，而不必一次性完成所有空间。",{"children":"模块化的优势在于可以在项目推进中逐步扩展，而不必一次性完成所有空间。"}]]]}],["$","section","让配置跟上使用需求",{"id":"section-3","children":[["$","h2",null,{"children":"让配置跟上使用需求"}],[["$","p","照明、插座、网络、空调、隔断和储物等细节，决定了办公室是否真正好用。规划阶段确定这些配置，可减少后期反复改造。",{"children":"照明、插座、网络、空调、隔断和储物等细节，决定了办公室是否真正好用。规划阶段确定这些配置，可减少后期反复改造。"}]]]}]],["$","div",null,{"className":"articleCallout","children":[["$","b",null,{"children":"需要结合您的项目判断？"}],["$","p",null,{"children":"告诉我们项目地点、使用人数和计划时间，卓雅可提供对应产品与空间方案建议。"}],["$","a",null,{"href":"/#contact","children":"获取项目建议 →"}]]}]]}]]}],["$","section",null,{"className":"related","children":[["$","p",null,{"className":"kicker","children":"RELATED"}],["$","h2",null,{"children":"相关内容"}],["$","div",null,{"children":[["$","a","打包箱产品详情",{"href":"/products/flat-pack","children":["打包箱产品详情",["$","b",null,{"children":"→"}]]}],["$","a","获取办公营地方案",{"href":"/projects/industrial-park-office","children":["获取办公营地方案",["$","b",null,{"children":"→"}]]}]]}]]}],["$","footer",null,{"children":[["$","span",null,{"children":"广东卓雅集成房屋有限公司"}],["$","a",null,{"href":"/news","children":"返回资讯中心 ↑"}]]}]]}]
